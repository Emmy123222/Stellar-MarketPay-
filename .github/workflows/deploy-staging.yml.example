# EXAMPLE: Deploy Staging Workflow
# 
# This is an example workflow showing how to:
# 1. Validate all required secrets using the preflight job
# 2. Fail fast with clear error messages if secrets are missing
# 3. Deploy to staging using SSH and blue-green strategy
#
# To use this workflow:
# 1. Copy this file to deploy-staging.yml
# 2. Configure GitHub secrets: SSH_HOST, SSH_USER, SSH_KEY, APP_DIR, DISCORD_WEBHOOK_URL
# 3. Customize deployment logic for your environment
# 4. Test on a non-production branch first
#
# See docs/ci-secrets.md for detailed setup instructions.

name: Deploy Staging

on:
  push:
    branches: [develop]
  workflow_dispatch:

permissions:
  contents: read

jobs:
  preflight:
    name: Validate Deployment Secrets
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - name: Check required secrets
        run: |
          echo "🔍 Validating secrets for staging deployment..."
          echo ""
          
          REQUIRED_SECRETS=(
            "SSH_HOST"
            "SSH_USER"
            "SSH_KEY"
            "APP_DIR"
          )
          
          OPTIONAL_SECRETS=(
            "DISCORD_WEBHOOK_URL"
          )
          
          MISSING=()
          for SECRET in "${REQUIRED_SECRETS[@]}"; do
            if [ -z "$(eval "echo \${{ secrets.$SECRET }}")" ]; then
              MISSING+=("$SECRET")
            fi
          done
          
          if [ ${#MISSING[@]} -gt 0 ]; then
            echo "❌ DEPLOYMENT BLOCKED: Missing required secrets"
            echo ""
            echo "The following secrets must be configured in GitHub:"
            for SECRET in "${MISSING[@]}"; do
              echo "  ❌ $SECRET (REQUIRED)"
            done
            echo ""
            echo "📖 Setup instructions: https://github.com/${{ github.repository }}/blob/main/docs/ci-secrets.md"
            echo ""
            echo "**Quick setup:**"
            echo "1. Go to Settings → Secrets and variables → Actions"
            echo "2. Click 'New repository secret' for each missing secret"
            echo "3. For SSH_KEY, use the contents of your private SSH key (cat ~/.ssh/id_rsa)"
            echo ""
            exit 1
          fi
          
          echo "✅ All required secrets are configured:"
          for SECRET in "${REQUIRED_SECRETS[@]}"; do
            echo "  ✓ $SECRET"
          done
          echo ""
          echo "Optional secrets:"
          for SECRET in "${OPTIONAL_SECRETS[@]}"; do
            if [ -n "$(eval "echo \${{ secrets.$SECRET }}")" ]; then
              echo "  ✓ $SECRET (configured)"
            else
              echo "  ○ $SECRET (not configured — notifications disabled)"
            fi
          done

  deploy:
    name: Deploy to Staging
    runs-on: ubuntu-latest
    needs: preflight
    environment: staging
    steps:
      - uses: actions/checkout@v4

      - name: Setup SSH
        run: |
          mkdir -p ~/.ssh
          echo "${{ secrets.SSH_KEY }}" > ~/.ssh/deploy_key
          chmod 600 ~/.ssh/deploy_key
          ssh-keyscan -H ${{ secrets.SSH_HOST }} >> ~/.ssh/known_hosts 2>/dev/null || true

      - name: Deploy via SSH
        run: |
          SSH_CMD="ssh -i ~/.ssh/deploy_key ${{ secrets.SSH_USER }}@${{ secrets.SSH_HOST }}"
          
          echo "🚀 Starting deployment to staging..."
          $SSH_CMD "cd ${{ secrets.APP_DIR }} && bash deploy/deploy.sh"
          
          if [ $? -eq 0 ]; then
            echo "✅ Deployment successful"
          else
            echo "❌ Deployment failed"
            exit 1
          fi

      - name: Notify Discord (success)
        if: success() && secrets.DISCORD_WEBHOOK_URL != ''
        run: |
          PAYLOAD=$(cat <<EOF
          {
            "username": "Deployment Bot",
            "avatar_url": "https://github.com/github.png",
            "embeds": [{
              "color": 3066993,
              "title": "✅ Staging Deployment Successful",
              "description": "Branch: **${{ github.ref_name }}**\nCommit: \`${{ github.sha }}\`",
              "url": "${{ github.server_url }}/${{ github.repository }}/actions/runs/${{ github.run_id }}",
              "timestamp": "$(date -u +'%Y-%m-%dT%H:%M:%SZ')"
            }]
          }
          EOF
          )
          curl -X POST "${{ secrets.DISCORD_WEBHOOK_URL }}" \
            -H "Content-Type: application/json" \
            -d "$PAYLOAD"

      - name: Notify Discord (failure)
        if: failure() && secrets.DISCORD_WEBHOOK_URL != ''
        run: |
          PAYLOAD=$(cat <<EOF
          {
            "username": "Deployment Bot",
            "avatar_url": "https://github.com/github.png",
            "embeds": [{
              "color": 15158332,
              "title": "❌ Staging Deployment Failed",
              "description": "Branch: **${{ github.ref_name }}**\nCommit: \`${{ github.sha }}\`",
              "url": "${{ github.server_url }}/${{ github.repository }}/actions/runs/${{ github.run_id }}",
              "timestamp": "$(date -u +'%Y-%m-%dT%H:%M:%SZ')"
            }]
          }
          EOF
          )
          curl -X POST "${{ secrets.DISCORD_WEBHOOK_URL }}" \
            -H "Content-Type: application/json" \
            -d "$PAYLOAD" || true
