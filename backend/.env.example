# Backend listener port.
PORT=4000
# Runtime mode; use production to enable strict security behavior.
NODE_ENV=development

# PostgreSQL connection used by the backend and migrations.
DATABASE_URL=postgresql://stellarwork:stellarwork_dev@localhost:5432/stellarwork
# Minimum number of idle database connections to keep open.
DATABASE_POOL_MIN=2
# Maximum number of database connections in the pool.
DATABASE_POOL_MAX=10
# Milliseconds before an idle database connection is closed.
DATABASE_POOL_IDLE_TIMEOUT_MS=30000
# Milliseconds to wait for a database connection from the pool.
DATABASE_POOL_CONNECTION_TIMEOUT_MS=5000
# Encryption key for sensitive database fields; use a random value of 16+ characters.
DATABASE_ENCRYPTION_KEY=replace-with-a-long-random-secret-at-least-16-chars

# JWT signing key; replace with a strong random value before starting the backend.
JWT_SECRET=replace-with-a-long-random-secret
# CSRF token signing key; required in production and may be separate from JWT_SECRET.
CSRF_SECRET=replace-with-a-long-random-secret
# Comma-separated Stellar wallet addresses granted administrator access.
ADMIN_WALLET_ADDRESSES=

# Stellar network selected for contract and wallet operations.
STELLAR_NETWORK=testnet
# Horizon API endpoint for the selected Stellar network.
HORIZON_URL=https://horizon-testnet.stellar.org
# Soroban escrow contract ID used by the backend indexer.
CONTRACT_ID=CBFJNX67NYYRZPLH4YYT77ZUULRJ5NI2LPEYRRLFHBTEACZOZUUYLOGG
# Stellar keypair secret for SEP-10 challenge transaction generation.
SERVER_PRIVATE_KEY=

# Comma-separated frontend origins allowed to call the backend.
ALLOWED_ORIGINS=http://localhost:3000
# Queue and cache Redis URL; the local default works with docker compose redis.
REDIS_URL=redis://localhost:6379

# SMTP server hostname; leave blank to disable SMTP delivery.
SMTP_HOST=
# SMTP server port.
SMTP_PORT=587
# SMTP login username.
SMTP_USER=
# SMTP login password.
SMTP_PASS=
# Sender address used by server and digest email transports.
SMTP_FROM=
# Sender address used by notification email utilities.
EMAIL_FROM=

# Frontend URL used to generate feed and digest links.
BASE_URL=http://localhost:3000
# Frontend origin embedded in email links.
FRONTEND_URL=http://localhost:3000
# Backend origin used by unsubscribe links and Swagger documentation.
API_BASE_URL=http://localhost:4000

# Comma-separated email addresses for weekly administrator reports.
ADMIN_EMAIL=
# Optional S3-compatible endpoint for report persistence; blank uses in-memory storage.
S3_ENDPOINT=
# S3 bucket used for generated reports.
S3_BUCKET=marketpay-reports
# S3 region used for generated reports.
S3_REGION=us-east-1
# S3-compatible access key ID.
S3_ACCESS_KEY=
# S3-compatible secret access key.
S3_SECRET_KEY=

# Anthropic Claude API key; leave blank to disable AI scoring features.
CLAUDE_API_KEY=
